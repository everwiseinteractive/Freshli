    "AI-powered receipt scanning is coming soon! For now, use the barcode scanner or add items manually.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-gestützte Beleg-Erkennung kommt bald! Bis dahin nutze den Strichcode-Scanner oder füge Artikel manuell hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escaneo de recibos con IA llegará pronto. Por ahora, usa el escáner de códigos de barras o añade artículos manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analyse des tickets de caisse par IA arrive bientôt ! Pour l'instant, utilisez le scanner de code-barres ou ajoutez les articles manuellement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIによるレシートスキャンは近日公開予定です。今のところはバーコードスキャナーまたは手動でアイテムを追加してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em breve: leitura de recibos com IA. Por enquanto, use o leitor de códigos de barras ou adicione manualmente."
          }
        }
      }
    },
