    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Freshli can add expiry dates to your Calendar so you see what needs using on your daily agenda. This is optional — you'll be asked the first time you turn it on in Settings."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli verwendet deine Kamera, um Barcodes und Kassenbons zu scannen und Artikel schnell hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli uses your camera to scan barcodes and receipts for quick item entry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli usa tu cámara para escanear códigos de barras y recibos para registrar productos rápidamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli utilise votre caméra pour scanner les codes-barres et les reçus afin d’ajouter rapidement vos produits."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshliはカメラを使用してバーコードやレシートをスキャンし、食品を素早く登録します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Freshli usa sua câmera para escanear códigos de barras e recibos para cadastrar itens rapidamente."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Freshli uses Face ID to confirm you're the account owner when you stake a Trust Badge on a community listing or claim. Your face data never leaves the device — Apple's Face ID handles authentication entirely on-device."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli verwendet deinen Standort, um Lebensmittelangebote in der Nähe anzuzeigen und Abholorte festzulegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli uses your location to show nearby community food listings and set pickup locations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli usa tu ubicación para mostrar alimentos compartidos cerca de ti y establecer puntos de recogida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli utilise votre position pour afficher les annonces alimentaires proches et définir les lieux de retrait."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshliは位置情報を使用して近くのコミュニティ食品情報を表示し、受け取り場所を設定します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Freshli usa sua localização para mostrar anúncios de alimentos próximos e definir locais de retirada."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Freshli uses gyroscope readings to make the Liquid Glass surfaces catch the light as you tilt your device — the same way real glass would. Motion data is read only while the app is open, never sent off-device, and never stored."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli speichert geteilte Rezeptbilder und Impact-Karten in deiner Fotomediathek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli saves shared recipe images and impact cards to your photo library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli guarda imágenes de recetas compartidas y tarjetas de impacto en tu biblioteca de fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli enregistre les images de recettes partagées et les cartes d’impact dans votre photothèque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshliは共有レシピ画像やインパクトカードを写真ライブラリに保存します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Freshli salva imagens de receitas compartilhadas e cartões de impacto na sua biblioteca de fotos."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli greift auf deine Fotos zu, um Bilder zu Vorratsartikeln und Community-Anzeigen hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli accesses your photos to add images to pantry items and community listings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli accede a tus fotos para agregar imágenes a los productos de tu despensa y a los anuncios comunitarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshli accède à vos photos pour ajouter des images à vos produits et annonces communautaires."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freshliは写真にアクセスして、食品やコミュニティ出品に画像を追加します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Freshli acessa suas fotos para adicionar imagens aos itens da despensa e anúncios da comunidade."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "comment" : "Privacy - Reminders Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Freshli can create Reminders for items expiring soon so you get a Lock Screen nudge a day before. This is optional — you'll be asked the first time you turn it on in Settings."
          }
        }
      }
    }
  },
  "version" : "1.0"
}